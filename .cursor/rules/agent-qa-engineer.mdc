### test_color_detector.py (7 тестов)
```python
def test_detect_hsv_white(color_detector, white_object_image, white_mask):
    result = color_detector.detect_hsv(white_object_image, white_mask)
    assert result.name == "white"
    assert result.method == "hsv"
    assert result.confidence > 0.5

def test_detect_hsv_black(color_detector, black_object_image):
    # get mask from black region
    mask = np.zeros((480, 640), dtype=np.uint8)
    mask[100:380, 120:520] = 255
    result = color_detector.detect_hsv(black_object_image, mask)
    assert result.name == "black"

def test_detect_kmeans_white(color_detector, white_object_image, white_mask):
    result = color_detector.detect_kmeans(white_object_image, white_mask)
    assert result.name == "white"
    assert result.method == "kmeans"

def test_detect_kmeans_black(color_detector, black_object_image):
    mask = np.zeros((480, 640), dtype=np.uint8)
    mask[100:380, 120:520] = 255
    result = color_detector.detect_kmeans(black_object_image, mask)
    assert result.name == "black"

def test_combined_agreement(color_detector, white_object_image, white_mask):
    result = color_detector.detect(white_object_image, white_mask)
    assert result.method_used == "combined"
    assert result.primary_color == "white"

def test_combined_disagreement_penalty(color_detector):
    # Craft ambiguous image where methods may disagree
    # Just verify that penalty is applied when confidence < 1.0
    pass  # implementation-dependent

def test_empty_mask_no_crash(color_detector, white_object_image):
    empty_mask = np.zeros((480, 640), dtype=np.uint8)
    result = color_detector.detect_hsv(white_object_image, empty_mask)
    assert result.name == "unknown"
    assert result.confidence == 0.0
```

### test_pipeline.py (5 тестов)
```python
def test_enhance_preserves_shape(pipeline, white_object_image):
    result = pipeline.enhance(white_object_image)
    assert result.shape == white_object_image.shape
    assert result.dtype == np.uint8

def test_segment_returns_binary(pipeline, white_object_image):
    enhanced = pipeline.enhance(white_object_image)
    mask = pipeline.segment(enhanced)
    unique_values = set(np.unique(mask))
    assert unique_values.issubset({0, 255})

def test_clean_reduces_noise(pipeline, white_object_image):
    enhanced = pipeline.enhance(white_object_image)
    mask = pipeline.segment(enhanced)
    cleaned = pipeline.clean(mask)
    assert cleaned.shape == mask.shape

def test_full_pipeline_returns_result(pipeline, white_object_image):
    from src.models import PipelineResult
    result = pipeline.run(white_object_image)
    assert isinstance(result, PipelineResult)
    assert result.original is not None
    assert result.decision is not None

def test_pipeline_empty_image_no_crash(pipeline):
    empty = np.zeros((480, 640, 3), dtype=np.uint8)
    result = pipeline.run(empty)
    # Should not raise, should return result with "Объект не найден"
    assert result is not None
```

### test_data_exporter.py (2 теста)
```python
def test_csv_created_with_header(tmp_path, config):
    from src.data_exporter import DataExporter
    from src.models import Decision
    config.csv_output_path = str(tmp_path / "results.csv")
    exporter = DataExporter(config)
    decision = Decision(category="Тест", confidence=0.9, color="white",
                        size="small", method_used="hsv", is_unknown=False,
                        closest_match="", timestamp="2026-01-01T00:00:00")
    exporter.export(decision)
    import pandas as pd
    df = pd.read_csv(config.csv_output_path)
    assert "category" in df.columns
    assert len(df) == 1

def test_csv_appends_rows(tmp_path, config):
    from src.data_exporter import DataExporter
    from src.models import Decision
    config.csv_output_path = str(tmp_path / "results.csv")
    exporter = DataExporter(config)
    for i in range(3):
        d = Decision(category=f"Cat{i}", confidence=0.8, color="black",
                     size="medium", method_used="kmeans", is_unknown=False,
                     closest_match="", timestamp="2026-01-01T00:00:00")
        exporter.export(d)
    import pandas as pd
    df = pd.read_csv(config.csv_output_path)
    assert len(df) == 3
```

## Запуск тестов
```bash
uv run pytest tests/ -v                    # все тесты с деталями
uv run pytest tests/test_pipeline.py -v   # только пайплайн
uv run pytest tests/ -k "white"           # только тесты с "white" в имени
uv run pytest tests/ --tb=short           # короткие трейсбеки
```

## При падении теста — план действий
1. Прочитай полный traceback — найди строку `AssertionError`
2. Добавь `print(result)` перед assertion и перезапусти с `-s`
3. Проверь, не изменилась ли модель данных (models.py) — это частая причина
4. Проверь, не изменились ли дефолты в AppConfig
